# Create a game called 'Guess the number'. Let us go through the Rules one by one.
#    1. The computer will generate a Random Number.
#
#    2. Ask the user to guess the number in 10 chances.
#
#   3. If the user guesses it right, Score him accordingly like if the user guesses in the first
#   chance, the score is 100, in second chance score should be 90, and so on.

#   4.If the guess number is greater than the random number give him 'Hint: Choose a Lower Number' or
#   less than the random number give him 'hint: Choose a Higher Number' or if the guess number is equal to
#   random, No need to hint, just display score and end the game.

#  5. Also show how many chances are left.
#  6. if the user cannot guess the number, disclose the random number and end the game.



import random
comp=random.randint(a=1,b=50)
print(comp)
chance=1
while chance<10:
    user=int(input('guess the number'))
    if user==comp:
        print('you won')
        print(f"you won and your score is {110-(chance*10)}")
        break
    elif user>comp:
        print('HINT: Guess lowewr no.')
        print(f'no. of chances left is {10-chance}')
    elif user < comp:
        print('HINT: Guess higher no.')
        print(f'no. of chances left is {10-chance}')


    chance=chance+1
else:
    print('you loose')
    print('the random no. was',comp)
